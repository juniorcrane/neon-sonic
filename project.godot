; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neon Sonic"
run/main_scene="uid://ddps25mogjoba"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/mode=4
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Project Neon"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/staging_buffer/max_size_mb=512
rendering_device/staging_buffer/texture_upload_region_size_px=128
rendering_device/staging_buffer/texture_download_region_size_px=128
rendering_device/vulkan/max_descriptors_per_pool=128
rendering_device/d3d12/max_sampler_descriptors=2048
rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
